gs\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#three-security-profiles\",\"content\":\"Dynamic imports\"}],[\"/docs/articles/renderify-technical-182\",{\"id\":\"/docs/articles/renderify-technical-182\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#three-security-profiles\",\"content\":\"Blocked\"}],[\"/docs/articles/renderify-technical-183\",{\"id\":\"/docs/articles/renderify-technical-183\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#three-security-profiles\",\"content\":\"Blocked\"}],[\"/docs/articles/renderify-technical-184\",{\"id\":\"/docs/articles/renderify-technical-184\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#three-security-profiles\",\"content\":\"Allowed\"}],[\"/docs/articles/renderify-technical-185\",{\"id\":\"/docs/articles/renderify-technical-185\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#seven-defense-layers\",\"content\":\"**Static pattern analysis**: Regex-based detection of dangerous source patterns (`eval(`, `new Function(`, `fetch(`, `document.cookie`, `localStorage`, `child_process`, etc.), plus path-traversal detection on module specifiers (including encoded variants).\"}],[\"/docs/articles/renderify-technical-186\",{\"id\":\"/docs/articles/renderify-technical-186\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#seven-defense-layers\",\"content\":\"**Structural limits**: Tree depth, node count, source byte size.\"}],[\"/docs/articles/renderify-technical-187\",{\"id\":\"/docs/articles/renderify-technical-187\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#seven-defense-layers\",\"content\":\"**Tag blocklist**: Blocks `script`, `iframe`, `object`, `embed`, and other dangerous tags.\"}],[\"/docs/articles/renderify-technical-188\",{\"id\":\"/docs/articles/renderify-technical-188\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#seven-defense-layers\",\"content\":\"**Module allowlist**: Only pre-approved modules may be imported.\"}],[\"/docs/articles/renderify-technical-189\",{\"id\":\"/docs/articles/renderify-technical-189\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#seven-defense-layers\",\"content\":\"**Manifest integrity**: In strict mode, all imports must have exact URL mappings.\"}],[\"/docs/articles/renderify-technical-190\",{\"id\":\"/docs/articles/renderify-technical-190\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#seven-defense-layers\",\"content\":\"**Execution budgets**: Wall-clock timeouts, import count limits, and component invocation limits, enforced via `Promise.race()`.\"}],[\"/docs/articles/renderify-technical-191\",{\"id\":\"/docs/articles/renderify-technical-191\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#seven-defense-layers\",\"content\":\"**Sandbox isolation**: Three sandbox modes — Worker/iframe/ShadowRealm — with automatic fallback chains.\"}],[\"/docs/articles/renderify-technical-192\",{\"id\":\"/docs/articles/renderify-technical-192\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#seven-defense-layers\",\"content\":\"The overall strategy is **fail-closed by default**: tags, modules, hosts, and execution profiles not explicitly permitted by the policy are rejected. In strict/balanced mode, uncovered bare specifiers are also rejected. The `relaxed` profile selectively loosens these constraints.\"}],[\"/docs/articles/renderify-technical-193\",{\"id\":\"/docs/articles/renderify-technical-193\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#browser-esm-module-graph-materialization\",\"content\":\"A key engineering capability of Renderify is how it resolves and loads npm packages entirely in the browser — without any server-side bundler.\"}],[\"/docs/articles/renderify-technical-194\",{\"id\":\"/docs/articles/renderify-technical-194\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#background\",\"content\":\"Browsers natively support ES Modules, but with one critical limitation: **bare specifiers are not supported**. You cannot directly `import { format } from \\\"date-fns\\\"` in the browser. Traditional solutions require bundlers like webpack or Vite to resolve these specifiers on the server, which contradicts Renderify's zero-build-step design goal.\"}],[\"/docs/articles/renderify-technical-195\",{\"id\":\"/docs/articles/renderify-technical-195\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#solution-the-fetch--rewrite--blob-url-pipeline\",\"content\":\"The detailed flow:\"}],[\"/docs/articles/renderify-technical-196\",{\"id\":\"/docs/articles/renderify-technical-196\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#solution-the-fetch--rewrite--blob-url-pipeline\",\"content\":\"**Lexical extraction**: Use `es-module-lexer` to extract all import declarations from the source code.\"}],[\"/docs/articles/renderify-technical-197\",{\"id\":\"/docs/articles/renderify-technical-197\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#solution-the-fetch--rewrite--blob-url-pipeline\",\"content\":\"**Specifier resolution**: Resolve bare specifiers (e.g., `recharts`) to exact CDN URLs via the JSPM CDN.\"}],[\"/docs/articles/renderify-technical-198\",{\"id\":\"/docs/articles/renderify-technical-198\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#solution-the-fetch--rewrite--blob-url-pipeline\",\"content\":\"**Recursive materialization**: Fetch remote module source, parse its child imports, and recursively repeat the same process.\"}],[\"/docs/articles/renderify-technical-199\",{\"id\":\"/docs/articles/renderify-technical-199\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#solution-the-fetch--rewrite--blob-url-pipeline\",\"content\":\"**Rewriting**: Replace all import specifiers with materialized blob/data URLs.\"}],[\"/docs/articles/renderify-technical-200\",{\"id\":\"/docs/articles/renderify-technical-200\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#solution-the-fetch--rewrite--blob-url-pipeline\",\"content\":\"**Packaging**: Create a blob URL from the rewritten source.\"}],[\"/docs/articles/renderify-technical-201\",{\"id\":\"/docs/articles/renderify-technical-201\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#solution-the-fetch--rewrite--blob-url-pipeline\",\"content\":\"**Loading**: Load the blob URL via `dynamic import()`.\"}],[\"/docs/articles/renderify-technical-202\",{\"id\":\"/docs/articles/renderify-technical-202\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#asset-proxy-modules\",\"content\":\"For non-JavaScript assets, Renderify handles them transparently through proxy modules:\"}],[\"/docs/articles/renderify-technical-203\",{\"id\":\"/docs/articles/renderify-technical-203\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#asset-proxy-modules\",\"content\":\"**CSS imports**: Converted to `<style>` injection proxy modules (deduplicated by FNV-1a hash — created on first encounter, reused on subsequent ones).\"}],[\"/docs/articles/renderify-technical-204\",{\"id\":\"/docs/articles/renderify-technical-204\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#asset-proxy-modules\",\"content\":\"**JSON imports**: Wrapped as `export default <parsed-json>` ESM modules.\"}],[\"/docs/articles/renderify-technical-205\",{\"id\":\"/docs/articles/renderify-technical-205\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#asset-proxy-modules\",\"content\":\"**Binary assets**: Converted to proxy modules that export the CDN URL.\"}],[\"/docs/articles/renderify-technical-206\",{\"id\":\"/docs/articles/renderify-technical-206\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#auto-pin-latest-strategy\",\"content\":\"`renderPlanInBrowser` enables auto-pin-latest mode by default:\"}],[\"/docs/articles/renderify-technical-207\",{\"id\":\"/docs/articles/renderify-technical-207\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#auto-pin-latest-strategy\",\"content\":\"Developers use bare imports in source code (e.g., `import { format } from \\\"date-fns/format\\\"`).\"}],[\"/docs/articles/renderify-technical-208\",{\"id\":\"/docs/articles/renderify-technical-208\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#auto-pin-latest-strategy\",\"content\":\"On first run, Renderify resolves the bare specifier to an exact versioned URL via JSPM.\"}],[\"/docs/articles/renderify-technical-209\",{\"id\":\"/docs/articles/renderify-technical-209\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#auto-pin-latest-strategy\",\"content\":\"The resolution result is immediately injected into the `moduleManifest`; subsequent executions use the pinned version.\"}],[\"/docs/articles/renderify-technical-210\",{\"id\":\"/docs/articles/renderify-technical-210\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#auto-pin-latest-strategy\",\"content\":\"For production, use `manifest-only` mode (`autoPinLatestModuleManifest: false`) to ensure fully pre-pinned, auditable dependency mappings.\"}],[\"/docs/articles/renderify-technical-211\",{\"id\":\"/docs/articles/renderify-technical-211\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#react-ecosystem-compatibility-bridge\",\"content\":\"LLM-generated code typically uses the React API — it is the most common frontend framework in model training data.\"}],[\"/docs/articles/renderify-technical-212\",{\"id\":\"/docs/articles/renderify-technical-212\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#react-ecosystem-compatibility-bridge\",\"content\":\"Renderify transparently redirects common React imports to the Preact compat layer via built-in compatibility mappings (Preact is approximately 3–4KB gzipped, significantly smaller than the React runtime; exact figures vary by version), reducing runtime overhead and improving cold-start performance:\"}],[\"/docs/articles/renderify-technical-213\",{\"id\":\"/docs/articles/renderify-technical-213\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#react-ecosystem-compatibility-bridge\",\"content\":\"This means LLMs can freely generate standard React code, and it will execute on the smaller, faster Preact runtime. React ecosystem libraries such as Recharts and MUI work as expected.\"}],[\"/docs/articles/renderify-technical-214\",{\"id\":\"/docs/articles/renderify-technical-214\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#streaming-rendering-architecture\",\"content\":\"In Chat UI scenarios, users expect real-time feedback. Renderify's streaming pipeline delivers progressive preview updates while the LLM is still generating code:\"}],[\"/docs/articles/renderify-technical-215\",{\"id\":\"/docs/articles/renderify-technical-215\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#streaming-rendering-architecture\",\"content\":\"**llm-delta**: Each token from the LLM is emitted as a chunk.\"}],[\"/docs/articles/renderify-technical-216\",{\"id\":\"/docs/articles/renderify-technical-216\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#streaming-rendering-architecture\",\"content\":\"**preview**: At configurable intervals, the accumulated text is parsed and rendered as a preview.\"}],[\"/docs/articles/renderify-technical-217\",{\"id\":\"/docs/articles/renderify-technical-217\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#streaming-rendering-architecture\",\"content\":\"**final**: After LLM completion, the full pipeline executes and emits the final result.\"}],[\"/docs/articles/renderify-technical-218\",{\"id\":\"/docs/articles/renderify-technical-218\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#streaming-rendering-architecture\",\"content\":\"**error**: If any stage fails, an error chunk is emitted before the exception propagates.\"}],[\"/docs/articles/renderify-technical-219\",{\"id\":\"/docs/articles/renderify-technical-219\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#efficient-change-detection\",\"content\":\"The streaming code generation stage uses FNV-1a 64-bit hashing for efficient change detection. As the LLM continuously outputs tokens, the system computes a hash signature over the accumulated text — only re-parsing and re-rendering when the signature changes. This avoids redundant computation during streaming while maintaining responsive incremental previews.\"}],[\"/docs/articles/renderify-technical-220\",{\"id\":\"/docs/articles/renderify-technical-220\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#plugin-system\",\"content\":\"The `CustomizationEngine` provides 10 hook points covering every pipeline stage:\"}],[\"/docs/articles/renderify-technical-221\",{\"id\":\"/docs/articles/renderify-technical-221\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#plugin-system\",\"content\":\"Each hook receives the current stage's payload and can transform it before passing it to the next stage. Multiple plugins execute in registration order. This design lets developers inject custom logic without forking the core — from modifying the LLM prompt to post-processing render output.\"}],[\"/docs/articles/renderify-technical-222\",{\"id\":\"/docs/articles/renderify-technical-222\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"For scenarios requiring stronger isolation, Renderify accepts three browser sandbox profile names:\"}],[\"/docs/articles/renderify-technical-223\",{\"id\":\"/docs/articles/renderify-technical-223\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Mode\"}],[\"/docs/articles/renderify-technical-224\",{\"id\":\"/docs/articles/renderify-technical-224\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Mechanism\"}],[\"/docs/articles/renderify-technical-225\",{\"id\":\"/docs/articles/renderify-technical-225\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Characteristics\"}],[\"/docs/articles/renderify-technical-226\",{\"id\":\"/docs/articles/renderify-technical-226\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"`sandbox-worker`\"}],[\"/docs/articles/renderify-technical-227\",{\"id\":\"/docs/articles/renderify-technical-227\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Web Worker + blob URL + `postMessage`\"}],[\"/docs/articles/renderify-technical-228\",{\"id\":\"/docs/articles/renderify-technical-228\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Separate-thread execution with timeout and abort support\"}],[\"/docs/articles/renderify-technical-229\",{\"id\":\"/docs/articles/renderify-technical-229\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"`sandbox-iframe`\"}],[\"/docs/articles/renderify-technical-230\",{\"id\":\"/docs/articles/renderify-technical-230\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Terminable Web Worker\"}],[\"/docs/articles/renderify-technical-231\",{\"id\":\"/docs/articles/renderify-technical-231\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Compatibility name; never executes source in an iframe\"}],[\"/docs/articles/renderify-technical-232\",{\"id\":\"/docs/articles/renderify-technical-232\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"`sandbox-shadowrealm`\"}],[\"/docs/articles/renderify-technical-233\",{\"id\":\"/docs/articles/renderify-technical-233\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Terminable Web Worker\"}],[\"/docs/articles/renderify-technical-234\",{\"id\":\"/docs/articles/renderify-technical-234\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"Compatibility name; never executes source same-thread\"}],[\"/docs/articles/renderify-technical-235\",{\"id\":\"/docs/articles/renderify-technical-235\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#sandbox-execution-model\",\"content\":\"All three require Worker support and fail closed when it is unavailable. A\\ntimeout or abort terminates the worker. Explicit sandbox execution profiles\\nnever fall back to non-sandboxed execution, even when\\n`browserSourceSandboxFailClosed` is disabled.\"}],[\"/docs/articles/renderify-technical-236\",{\"id\":\"/docs/articles/renderify-technical-236\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#dom-reconciliation-and-ui-rendering\",\"content\":\"`DefaultUIRenderer` is not a simple `innerHTML` replacement — it implements a full DOM reconciliation algorithm:\"}],[\"/docs/articles/renderify-technical-237\",{\"id\":\"/docs/articles/renderify-technical-237\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#dom-reconciliation-and-ui-rendering\",\"content\":\"**Keyed + positional child matching**: Prioritizes key-based matching, then falls back to positional matching.\"}],[\"/docs/articles/renderify-technical-238\",{\"id\":\"/docs/articles/renderify-technical-238\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#dom-reconciliation-and-ui-rendering\",\"content\":\"**Differential attribute updates**: Only updates attributes that have actually changed.\"}],[\"/docs/articles/renderify-technical-239\",{\"id\":\"/docs/articles/renderify-technical-239\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#dom-reconciliation-and-ui-rendering\",\"content\":\"**Text node updates**: Directly modifies `textContent` rather than replacing the node.\"}],[\"/docs/articles/renderify-technical-240\",{\"id\":\"/docs/articles/renderify-technical-240\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#dom-reconciliation-and-ui-rendering\",\"content\":\"**Interactive state preservation**: Preserves scroll positions during reconciliation and avoids overwriting `value`/`checked` on focused input elements.\"}],[\"/docs/articles/renderify-technical-241\",{\"id\":\"/docs/articles/renderify-technical-241\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#dom-reconciliation-and-ui-rendering\",\"content\":\"**Event delegation**: Implements event handling via `data-renderify-event-*` attributes and `CustomEvent` dispatch.\"}],[\"/docs/articles/renderify-technical-242\",{\"id\":\"/docs/articles/renderify-technical-242\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#dom-reconciliation-and-ui-rendering\",\"content\":\"**XSS protection**: Blocks dangerous tags/attributes and sanitizes inline styles (blocking `expression()`, `url()`, `javascript:`, etc.).\"}],[\"/docs/articles/renderify-technical-243\",{\"id\":\"/docs/articles/renderify-technical-243\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#one-line-embed-api\",\"content\":\"Renderify provides a minimal embed API — a single call completes the entire flow from Plan to rendered UI:\"}],[\"/docs/articles/renderify-technical-244\",{\"id\":\"/docs/articles/renderify-technical-244\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#one-line-embed-api\",\"content\":\"Internally, this call automatically creates all required infrastructure — module loader, security checker, runtime manager, UI renderer — and uses a `WeakMap`-backed render lock to ensure concurrent renders to the same DOM target are properly serialized.\"}],[\"/docs/articles/renderify-technical-245\",{\"id\":\"/docs/articles/renderify-technical-245\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#one-line-embed-api\",\"content\":\"A complete 30-second example:\"}],[\"/docs/articles/renderify-technical-246\",{\"id\":\"/docs/articles/renderify-technical-246\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#one-line-embed-api\",\"content\":\"The code above does three things: (1) executes JSX/TSX directly at browser runtime; (2) auto-resolves the `date-fns` bare import via JSPM; (3) pins the resolved URL into `moduleManifest` before execution.\"}],[\"/docs/articles/renderify-technical-247\",{\"id\":\"/docs/articles/renderify-technical-247\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#transpilation-cache\",\"content\":\"The runtime transpiler uses an LRU cache (256 entries) with cache keys composed from `language/runtime/filename/code`, avoiding redundant transpilation of unchanged source code.\"}],[\"/docs/articles/renderify-technical-248\",{\"id\":\"/docs/articles/renderify-technical-248\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#request-deduplication\",\"content\":\"Both `JspmModuleLoader` and `RuntimeSourceModuleLoader` implement request deduplication — when multiple components request the same module concurrently, only a single network request is made.\"}],[\"/docs/articles/renderify-technical-249\",{\"id\":\"/docs/articles/renderify-technical-249\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#multi-cdn-fault-tolerance\",\"content\":\"Module fetching supports multi-CDN fallback using `Promise.any` for hedged requests. The default source is the JSPM GA CDN, with fallback to esm.sh and other alternative CDNs on failure.\"}],[\"/docs/articles/renderify-technical-250\",{\"id\":\"/docs/articles/renderify-technical-250\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#budget-racing\",\"content\":\"Execution budgets constrain async paths via remaining-time calculation + `Promise.race()`. For synchronously blocking code, a genuinely separate, terminable execution boundary is required to mitigate main-thread stalls. The `isolated-vm` profile is currently reserved and fails closed; Renderify deliberately does not treat Node's `node:vm` as that security boundary.\"}],[\"/docs/articles/renderify-technical-251\",{\"id\":\"/docs/articles/renderify-technical-251\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#blob-url-cleanup\",\"content\":\"The runtime manager tracks all created blob URLs and revokes them in bulk during cleanup to prevent memory leaks.\"}],[\"/docs/articles/renderify-technical-252\",{\"id\":\"/docs/articles/renderify-technical-252\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"Parameter\"}],[\"/docs/articles/renderify-technical-253\",{\"id\":\"/docs/articles/renderify-technical-253\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"Default\"}],[\"/docs/articles/renderify-technical-254\",{\"id\":\"/docs/articles/renderify-technical-254\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"Impact\"}],[\"/docs/articles/renderify-technical-255\",{\"id\":\"/docs/articles/renderify-technical-255\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`enableDependencyPreflight`\"}],[\"/docs/articles/renderify-technical-256\",{\"id\":\"/docs/articles/renderify-technical-256\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`true`\"}],[\"/docs/articles/renderify-technical-257\",{\"id\":\"/docs/articles/renderify-technical-257\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"Better safety and earlier failure signals\"}],[\"/docs/articles/renderify-technical-258\",{\"id\":\"/docs/articles/renderify-technical-258\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`remoteFetchTimeoutMs`\"}],[\"/docs/articles/renderify-technical-259\",{\"id\":\"/docs/articles/renderify-technical-259\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`12000`\"}],[\"/docs/articles/renderify-technical-260\",{\"id\":\"/docs/articles/renderify-technical-260\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"Prevents long hangs\"}],[\"/docs/articles/renderify-technical-261\",{\"id\":\"/docs/articles/renderify-technical-261\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`remoteFetchRetries`\"}],[\"/docs/articles/renderify-technical-262\",{\"id\":\"/docs/articles/renderify-technical-262\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`2`\"}],[\"/docs/articles/renderify-technical-263\",{\"id\":\"/docs/articles/renderify-technical-263\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"Better resilience\"}],[\"/docs/articles/renderify-technical-264\",{\"id\":\"/docs/articles/renderify-technical-264\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`browserSourceSandboxMode`\"}],[\"/docs/articles/renderify-technical-265\",{\"id\":\"/docs/articles/renderify-technical-265\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`worker` in browser (`none` outside browser)\"}],[\"/docs/articles/renderify-technical-266\",{\"id\":\"/docs/articles/renderify-technical-266\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"Containment for reviewed source\"}],[\"/docs/articles/renderify-technical-267\",{\"id\":\"/docs/articles/renderify-technical-267\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`autoPinLatestModuleManifest`\"}],[\"/docs/articles/renderify-technical-268\",{\"id\":\"/docs/articles/renderify-technical-268\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"`true`\"}],[\"/docs/articles/renderify-technical-269\",{\"id\":\"/docs/articles/renderify-technical-269\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#tuning-parameters\",\"content\":\"Developer experience for bare imports\"}],[\"/docs/articles/renderify-technical-270\",{\"id\":\"/docs/articles/renderify-technical-270\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#use-cases\",\"content\":\"Renderify is well-suited for the following scenarios:\"}],[\"/docs/articles/renderify-technical-271\",{\"id\":\"/docs/articles/renderify-technical-271\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#use-cases\",\"content\":\"**LLM Chat / Agent platforms**: Render dynamic UI from model output — dashboards, forms, cards, data visualizations.\"}],[\"/docs/articles/renderify-technical-272\",{\"id\":\"/docs/articles/renderify-technical-272\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#use-cases\",\"content\":\"**AI Agent toolchains**: An Agent analyzes user data and dynamically generates interactive dashboards or operation interfaces, rather than just returning text.\"}],[\"/docs/articles/renderify-technical-273\",{\"id\":\"/docs/articles/renderify-technical-273\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#use-cases\",\"content\":\"**Low-Code / No-Code AI backends**: Users describe intent in natural language; the LLM generates a runnable UI component on the fly.\"}],[\"/docs/articles/renderify-technical-274\",{\"id\":\"/docs/articles/renderify-technical-274\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#use-cases\",\"content\":\"**Dynamic forms and approval workflows**: Generate context-aware forms at runtime, more flexible than JSON Schema renderers.\"}],[\"/docs/articles/renderify-technical-275\",{\"id\":\"/docs/articles/renderify-technical-275\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#use-cases\",\"content\":\"**Rapid prototyping**: Go from prompt to rendered UI in seconds, not minutes.\"}],[\"/docs/articles/renderify-technical-276\",{\"id\":\"/docs/articles/renderify-technical-276\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#use-cases\",\"content\":\"**Safe rendering of untrusted UI**: Any application that needs to securely render dynamically generated UI in the browser.\"}],[\"/docs/articles/renderify-technical-277\",{\"id\":\"/docs/articles/renderify-technical-277\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#renderer-only-mode-no-llm\",\"content\":\"From a capability standpoint, Renderify's LLM integration is optional. You can supply a RuntimePlan from any source — your backend API, another SDK, or a different model provider.\"}],[\"/docs/articles/renderify-technical-278\",{\"id\":\"/docs/articles/renderify-technical-278\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#renderer-only-mode-no-llm\",\"content\":\"Note that the top-level `renderify` package includes `@renderify/llm` as a dependency for out-of-the-box convenience. If you want to minimize the runtime entry point, use `@renderify/runtime` + `@renderify/ir` directly:\"}],[\"/docs/articles/renderify-technical-279\",{\"id\":\"/docs/articles/renderify-technical-279\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#1-ir-as-a-stable-contract\",\"content\":\"The RuntimePlan intermediate representation fully decouples LLM output format from execution and rendering. Even outside of Renderify, this IR design provides a reusable schema for any system that needs to describe \\\"LLM-generated interactive UI.\\\"\"}],[\"/docs/articles/renderify-technical-280\",{\"id\":\"/docs/articles/renderify-technical-280\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#2-reusable-security-policy-framework\",\"content\":\"A systematic approach to validating untrusted declarative plans and governing\\nreviewed dynamic source — tag blocklists, module allowlists, execution budgets,\\nand source pattern analysis. Source scanning and browser containment remain\\ndefense-in-depth controls rather than a guarantee for arbitrary hostile code.\"}],[\"/docs/articles/renderify-technical-281\",{\"id\":\"/docs/articles/renderify-technical-281\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#3-browser-esm-module-graph-materialization\",\"content\":\"The `fetch → rewrite imports → blob URL` pipeline solves a problem that browser standards have not yet natively addressed — bare specifiers are not usable in browsers. This module loading strategy can be extracted as a standalone utility.\"}],[\"/docs/articles/renderify-technical-282\",{\"id\":\"/docs/articles/renderify-technical-282\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#4-strategy-over-convention\",\"content\":\"Key components throughout the system employ the Strategy pattern — transpilers (Babel/esbuild), sandbox modes (Worker/iframe/ShadowRealm), LLM providers (multiple built-in implementations), module loaders — all are swappable implementations behind interfaces.\"}],[\"/docs/articles/renderify-technical-283\",{\"id\":\"/docs/articles/renderify-technical-283\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#5-zero-configuration-react-compatibility\",\"content\":\"LLMs generate standard React code that transparently executes on the Preact compat runtime — no additional configuration or special handling required.\"}],[\"/docs/articles/renderify-technical-284\",{\"id\":\"/docs/articles/renderify-technical-284\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#conclusion\",\"content\":\"Renderify represents an important infrastructure layer in LLM application development — it solves the last-mile problem between \\\"an LLM can generate code\\\" and \\\"users can see and interact with that UI.\\\" Its value stems from a set of composable engineering capabilities:\"}],[\"/docs/articles/renderify-technical-285\",{\"id\":\"/docs/articles/renderify-technical-285\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#conclusion\",\"content\":\"**Zero-build runtime rendering**: Fully browser-side transpilation and module resolution via Babel Standalone + JSPM CDN.\"}],[\"/docs/articles/renderify-technical-286\",{\"id\":\"/docs/articles/renderify-technical-286\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#conclusion\",\"content\":\"**Defense-in-depth security**: Seven independent defense layers ensuring LLM-generated untrusted code is executed safely.\"}],[\"/docs/articles/renderify-technical-287\",{\"id\":\"/docs/articles/renderify-technical-287\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#conclusion\",\"content\":\"**Browser ESM module graph materialization**: The fetch → rewrite → blob URL pipeline, constructing module dependency graphs in the browser.\"}],[\"/docs/articles/renderify-technical-288\",{\"id\":\"/docs/articles/renderify-technical-288\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#conclusion\",\"content\":\"**Streaming rendering**: Efficient change detection based on FNV-1a hashing, delivering real-time incremental UI previews.\"}],[\"/docs/articles/renderify-technical-289\",{\"id\":\"/docs/articles/renderify-technical-289\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#conclusion\",\"content\":\"**Minimal API**: A single line of code from RuntimePlan to fully rendered interactive UI.\"}],[\"/docs/articles/renderify-technical-290\",{\"id\":\"/docs/articles/renderify-technical-290\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#conclusion\",\"content\":\"Renderify provides a solid technical foundation for building the next generation of AI-driven dynamic UI applications. Whether it's rich interactive components in chat interfaces, AI Agent-generated data dashboards, or natural-language-driven low-code platforms, Renderify turns LLM UI generation capabilities into tangible, interactive product experiences.\"}],[\"/docs/articles/renderify-technical-291\",{\"id\":\"/docs/articles/renderify-technical-291\",\"page_id\":\"/docs/articles/renderify-technical\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/articles/renderify-technical#conclusion\",\"content\":\"A note on comparisons: cross-product size and performance claims should be substantiated with benchmarks under fixed versions, fixed scenarios, and fixed network conditions before drawing conclusions.\"}]]"}}