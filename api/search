ies\"}],[\"/docs/runtime-plan-ir-12\",{\"id\":\"/docs/runtime-plan-ir-12\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#execution-profiles\",\"content\":\"Execution Profiles\"}],[\"/docs/runtime-plan-ir-13\",{\"id\":\"/docs/runtime-plan-ir-13\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Execution Budgets\"}],[\"/docs/runtime-plan-ir-14\",{\"id\":\"/docs/runtime-plan-ir-14\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#state-model\",\"content\":\"State Model\"}],[\"/docs/runtime-plan-ir-15\",{\"id\":\"/docs/runtime-plan-ir-15\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#actions\",\"content\":\"Actions\"}],[\"/docs/runtime-plan-ir-16\",{\"id\":\"/docs/runtime-plan-ir-16\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#value-references\",\"content\":\"Value References\"}],[\"/docs/runtime-plan-ir-17\",{\"id\":\"/docs/runtime-plan-ir-17\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#events-and-forms\",\"content\":\"Events and forms\"}],[\"/docs/runtime-plan-ir-18\",{\"id\":\"/docs/runtime-plan-ir-18\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#bound-controls\",\"content\":\"Bound controls\"}],[\"/docs/runtime-plan-ir-19\",{\"id\":\"/docs/runtime-plan-ir-19\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#forms\",\"content\":\"Forms\"}],[\"/docs/runtime-plan-ir-20\",{\"id\":\"/docs/runtime-plan-ir-20\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#path-safety\",\"content\":\"Path Safety\"}],[\"/docs/runtime-plan-ir-21\",{\"id\":\"/docs/runtime-plan-ir-21\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#module-manifest\",\"content\":\"Module Manifest\"}],[\"/docs/runtime-plan-ir-22\",{\"id\":\"/docs/runtime-plan-ir-22\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#example-manifest\",\"content\":\"Example Manifest\"}],[\"/docs/runtime-plan-ir-23\",{\"id\":\"/docs/runtime-plan-ir-23\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#source-module\",\"content\":\"Source Module\"}],[\"/docs/runtime-plan-ir-24\",{\"id\":\"/docs/runtime-plan-ir-24\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#example-source-module\",\"content\":\"Example Source Module\"}],[\"/docs/runtime-plan-ir-25\",{\"id\":\"/docs/runtime-plan-ir-25\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#metadata\",\"content\":\"Metadata\"}],[\"/docs/runtime-plan-ir-26\",{\"id\":\"/docs/runtime-plan-ir-26\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"Built-in Compatibility Aliases\"}],[\"/docs/runtime-plan-ir-27\",{\"id\":\"/docs/runtime-plan-ir-27\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#utility-functions\",\"content\":\"Utility Functions\"}],[\"/docs/runtime-plan-ir-28\",{\"id\":\"/docs/runtime-plan-ir-28\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#node-creation\",\"content\":\"Node Creation\"}],[\"/docs/runtime-plan-ir-29\",{\"id\":\"/docs/runtime-plan-ir-29\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#validation-guards\",\"content\":\"Validation Guards\"}],[\"/docs/runtime-plan-ir-30\",{\"id\":\"/docs/runtime-plan-ir-30\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#tree-utilities\",\"content\":\"Tree Utilities\"}],[\"/docs/runtime-plan-ir-31\",{\"id\":\"/docs/runtime-plan-ir-31\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#path-utilities\",\"content\":\"Path Utilities\"}],[\"/docs/runtime-plan-ir-32\",{\"id\":\"/docs/runtime-plan-ir-32\",\"page_id\":\"/docs/runtime-plan-ir\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/runtime-plan-ir#complete-example\",\"content\":\"Complete Example\"}],[\"/docs/runtime-plan-ir-33\",{\"id\":\"/docs/runtime-plan-ir-33\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#runtimeplan-ir-reference\",\"content\":\"The RuntimePlan is the intermediate representation (IR) at the heart of Renderify. Every piece of UI that Renderify renders — whether generated by an LLM, authored by hand, or loaded from a file — is expressed as a RuntimePlan.\"}],[\"/docs/runtime-plan-ir-34\",{\"id\":\"/docs/runtime-plan-ir-34\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#required-fields\",\"content\":\"**`id`** — non-empty string identifying the plan. Used for state management and caching.\"}],[\"/docs/runtime-plan-ir-35\",{\"id\":\"/docs/runtime-plan-ir-35\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#required-fields\",\"content\":\"**`version`** — positive integer. Must be >= 1.\"}],[\"/docs/runtime-plan-ir-36\",{\"id\":\"/docs/runtime-plan-ir-36\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#required-fields\",\"content\":\"**`root`** — the top-level node of the UI tree.\"}],[\"/docs/runtime-plan-ir-37\",{\"id\":\"/docs/runtime-plan-ir-37\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#required-fields\",\"content\":\"**`capabilities`** — declares what the plan needs (even if empty `{}`).\"}],[\"/docs/runtime-plan-ir-38\",{\"id\":\"/docs/runtime-plan-ir-38\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#spec-version\",\"content\":\"The `specVersion` field declares the protocol contract. Currently the only version is `\\\"runtime-plan/v1\\\"`. In `strict` and `balanced` security profiles, this field is required.\"}],[\"/docs/runtime-plan-ir-39\",{\"id\":\"/docs/runtime-plan-ir-39\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#node-types\",\"content\":\"The UI tree is composed of five node types: `text`, `element`, and `component` render content, while `each` and `if` repeat or conditionally render their children.\"}],[\"/docs/runtime-plan-ir-40\",{\"id\":\"/docs/runtime-plan-ir-40\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#text-node\",\"content\":\"Template interpolation resolves `{{state.count}}`, `{{context.userId}}`, `{{vars.name}}` at render time.\"}],[\"/docs/runtime-plan-ir-41\",{\"id\":\"/docs/runtime-plan-ir-41\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#element-node\",\"content\":\"Props support standard HTML attributes. Event handlers use the `onClick`, `onInput` format and are converted to runtime event bindings; see Events and forms.\"}],[\"/docs/runtime-plan-ir-42\",{\"id\":\"/docs/runtime-plan-ir-42\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#component-node\",\"content\":\"Component nodes reference external modules loaded via the JSPM module loader. The `module` specifier is resolved through the module manifest or JSPM CDN.\"}],[\"/docs/runtime-plan-ir-43\",{\"id\":\"/docs/runtime-plan-ir-43\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#component-node\",\"content\":\"The referenced export is invoked as a Renderify component factory and must return a `RuntimeNode` tree or a string. Component nodes are not React or Preact component hosts.\"}],[\"/docs/runtime-plan-ir-44\",{\"id\":\"/docs/runtime-plan-ir-44\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#each-node\",\"content\":\"Children are rendered once per array item, in place: an `each` inside a `ul`\\nproduces `li` siblings without a wrapper element. Inside the loop, templates\\nand props can read the loop variables, such as `{{todo.title}}` and\\n`{{index}}`. Loops nest, and inner loops can read outer variables. `as` and\\n`index` must be simple identifiers other than `state`, `event`, `context`,\\nand `vars`.\"}],[\"/docs/runtime-plan-ir-45\",{\"id\":\"/docs/runtime-plan-ir-45\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#each-node\",\"content\":\"With `key`, each element produced by an iteration gets a stable key, so\\nremoving or reordering items reuses the right DOM nodes (and keeps focus and\\ncheckbox state on the right row). A single render may produce at most 10,000\\nnodes through `each`; beyond that, rendering stops and the runtime reports\\n`RUNTIME_EACH_LIMIT_EXCEEDED`.\"}],[\"/docs/runtime-plan-ir-46\",{\"id\":\"/docs/runtime-plan-ir-46\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#if-node\",\"content\":\"Without `equals`, children render when the value is truthy. Truthiness follows\\nJavaScript except that an empty array is false, so `\\\"when\\\": \\\"state.todos\\\"`\\nmeans \\\"has todos\\\". With `equals`, primitives compare by their text form\\n(`2` equals `\\\"2\\\"`), and string values may be templates such as\\n`\\\"{{item.id}}\\\"`. Use two `if` nodes, one with `\\\"not\\\": true`, for if/else.\"}],[\"/docs/runtime-plan-ir-47\",{\"id\":\"/docs/runtime-plan-ir-47\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#if-node\",\"content\":\"A control node in the plan root renders inside a\\n`<div data-renderify-fragment style=\\\"display:contents\\\">` wrapper so it does\\nnot affect layout.\"}],[\"/docs/runtime-plan-ir-48\",{\"id\":\"/docs/runtime-plan-ir-48\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Three budget dimensions are enforced at runtime:\"}],[\"/docs/runtime-plan-ir-49\",{\"id\":\"/docs/runtime-plan-ir-49\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Budget\"}],[\"/docs/runtime-plan-ir-50\",{\"id\":\"/docs/runtime-plan-ir-50\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Field\"}],[\"/docs/runtime-plan-ir-51\",{\"id\":\"/docs/runtime-plan-ir-51\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Description\"}],[\"/docs/runtime-plan-ir-52\",{\"id\":\"/docs/runtime-plan-ir-52\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Import count\"}],[\"/docs/runtime-plan-ir-53\",{\"id\":\"/docs/runtime-plan-ir-53\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"`maxImports`\"}],[\"/docs/runtime-plan-ir-54\",{\"id\":\"/docs/runtime-plan-ir-54\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Declared imports and distinct remote materializations\"}],[\"/docs/runtime-plan-ir-55\",{\"id\":\"/docs/runtime-plan-ir-55\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Component invocations\"}],[\"/docs/runtime-plan-ir-56\",{\"id\":\"/docs/runtime-plan-ir-56\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"`maxComponentInvocations`\"}],[\"/docs/runtime-plan-ir-57\",{\"id\":\"/docs/runtime-plan-ir-57\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Number of component renders\"}],[\"/docs/runtime-plan-ir-58\",{\"id\":\"/docs/runtime-plan-ir-58\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Wall-clock time\"}],[\"/docs/runtime-plan-ir-59\",{\"id\":\"/docs/runtime-plan-ir-59\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"`maxExecutionMs`\"}],[\"/docs/runtime-plan-ir-60\",{\"id\":\"/docs/runtime-plan-ir-60\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"Total execution time in milliseconds\"}],[\"/docs/runtime-plan-ir-61\",{\"id\":\"/docs/runtime-plan-ir-61\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#execution-budgets\",\"content\":\"`maxImports` covers declared imports and remote modules reached transitively\\nthrough component or runtime-source imports during the same execution. When a\\nbudget is exceeded, execution stops and a diagnostic error is emitted.\"}],[\"/docs/runtime-plan-ir-62\",{\"id\":\"/docs/runtime-plan-ir-62\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#state-model\",\"content\":\"When `state` is present, `state.initial` is required. The runtime maintains a snapshot per plan ID.\"}],[\"/docs/runtime-plan-ir-63\",{\"id\":\"/docs/runtime-plan-ir-63\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#actions\",\"content\":\"Five action types are available for state transitions:\"}],[\"/docs/runtime-plan-ir-64\",{\"id\":\"/docs/runtime-plan-ir-64\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#actions\",\"content\":\"Paths address array items by index (`todos.2.done`). A whole path segment may\\nbe a template, resolved when the event is handled, to target the item an event\\ncame from:\"}],[\"/docs/runtime-plan-ir-65\",{\"id\":\"/docs/runtime-plan-ir-65\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#actions\",\"content\":\"A template must fill its segment, and its value must be a string or\\nnon-negative integer that forms one safe segment; otherwise the action is\\nskipped with a `RUNTIME_ACTION_PATH_UNRESOLVED` diagnostic. Writing to a\\nmissing array index is also skipped rather than replacing the array.\"}],[\"/docs/runtime-plan-ir-66\",{\"id\":\"/docs/runtime-plan-ir-66\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#value-references\",\"content\":\"The `$from` syntax references values from other contexts:\"}],[\"/docs/runtime-plan-ir-67\",{\"id\":\"/docs/runtime-plan-ir-67\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#value-references\",\"content\":\"References may appear anywhere inside a `set` or `push` value, so a new list\\nitem can combine bound state and literals:\"}],[\"/docs/runtime-plan-ir-68\",{\"id\":\"/docs/runtime-plan-ir-68\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#value-references\",\"content\":\"Event binding payloads may contain references too. They are resolved against\\nstate when the event is handled, after earlier events in the same interaction\\nhave been applied, so the payload always carries what the user just entered.\\nA payload that is a single reference, such as `{ \\\"$from\\\": \\\"state.form\\\" }`,\\nbecomes the referenced object.\"}],[\"/docs/runtime-plan-ir-69\",{\"id\":\"/docs/runtime-plan-ir-69\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#events-and-forms\",\"content\":\"Element props named `on` + an event (`onClick`, `onInput`, `onChange`,\\n`onKeyDown`, ...) dispatch a runtime event. The value is either a transition\\nname or `{ \\\"type\\\": \\\"...\\\", \\\"payload\\\": { ... } }`. Inside `each`, payload\\ntemplates such as `\\\"{{index}}\\\"` capture the current item:\"}],[\"/docs/runtime-plan-ir-70\",{\"id\":\"/docs/runtime-plan-ir-70\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#events-and-forms\",\"content\":\"`onEnter` dispatches when Enter is pressed in a field (without modifier keys\\nor an active IME composition) and suppresses the newline.\"}],[\"/docs/runtime-plan-ir-71\",{\"id\":\"/docs/runtime-plan-ir-71\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#events-and-forms\",\"content\":\"Events from `input`, `textarea`, and `select` elements carry the control's\\nlive value in `event.payload.value`: a boolean for checkboxes (with\\n`event.payload.checked`), a number for number and range inputs, an array for\\nmulti-selects, and a string otherwise. Keys declared in the binding's payload\\ntake precedence over captured values.\"}],[\"/docs/runtime-plan-ir-72\",{\"id\":\"/docs/runtime-plan-ir-72\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#bound-controls\",\"content\":\"`bind` keeps a form control and a state path in sync without writing\\ntransitions:\"}],[\"/docs/runtime-plan-ir-73\",{\"id\":\"/docs/runtime-plan-ir-73\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#bound-controls\",\"content\":\"The control shows the state value, and each edit writes back to the path\\n(text-like controls on `input`, checkboxes, radios, and selects on `change`)\\nthrough a `renderify:bind` runtime event before any transitions run.\\nCheckboxes bind booleans; a radio is checked when the bound value equals its\\n`value`; number inputs bind numbers. The `state.` prefix is optional, and loop\\ntemplates in the path are resolved per item.\"}],[\"/docs/runtime-plan-ir-74\",{\"id\":\"/docs/runtime-plan-ir-74\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#bound-controls\",\"content\":\"When state changes the bound value, for example when an \\\"Add\\\" transition\\nclears `draft`, the control updates even if the user already edited it. A\\nfocused control is only updated when it is being cleared, so renders never\\noverwrite text while the user is typing.\"}],[\"/docs/runtime-plan-ir-75\",{\"id\":\"/docs/runtime-plan-ir-75\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#bound-controls\",\"content\":\"Password and file inputs are never bound and never captured, so their\\ncontents cannot reach plan state, events, or a host's model context.\"}],[\"/docs/runtime-plan-ir-76\",{\"id\":\"/docs/runtime-plan-ir-76\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#forms\",\"content\":\"A `form` element renders as an inert `<div data-renderify-form>` container\\nwithout `action`, `method`, or `target`, so it can never navigate the page or\\npost fields anywhere. The runtime emulates submission instead: `onSubmit`\\nfires when a submit button inside the form is clicked or Enter is pressed in\\none of its text fields. The payload contains the form's named fields, merged\\nunder any declared payload keys:\"}],[\"/docs/runtime-plan-ir-77\",{\"id\":\"/docs/runtime-plan-ir-77\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#forms\",\"content\":\"Submitting this form dispatches `tool:search_flights` with\\n`{ \\\"from\\\": \\\"...\\\", \\\"to\\\": \\\"...\\\" }`. A lone checkbox is a boolean, same-named\\ncheckboxes are the array of checked values, and a radio group is the checked\\nvalue or `null`. Disabled, password, and file fields are skipped. Fields keep\\nwhat the user typed after a submit; bind them when a transition should clear\\nthem.\"}],[\"/docs/runtime-plan-ir-78\",{\"id\":\"/docs/runtime-plan-ir-78\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#path-safety\",\"content\":\"All state paths are validated against prototype pollution. The following segments are rejected:\"}],[\"/docs/runtime-plan-ir-79\",{\"id\":\"/docs/runtime-plan-ir-79\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#path-safety\",\"content\":\"`__proto__`\"}],[\"/docs/runtime-plan-ir-80\",{\"id\":\"/docs/runtime-plan-ir-80\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#path-safety\",\"content\":\"`prototype`\"}],[\"/docs/runtime-plan-ir-81\",{\"id\":\"/docs/runtime-plan-ir-81\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#path-safety\",\"content\":\"`constructor`\"}],[\"/docs/runtime-plan-ir-82\",{\"id\":\"/docs/runtime-plan-ir-82\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#module-manifest\",\"content\":\"The manifest provides deterministic module resolution. In `strict` security profile, bare specifiers (like `\\\"recharts\\\"`) must have a manifest entry. In `strict` mode, remote modules must also include `integrity` hashes.\"}],[\"/docs/runtime-plan-ir-83\",{\"id\":\"/docs/runtime-plan-ir-83\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#source-module\",\"content\":\"Source modules enable richer interactivity than the declarative node tree. The source code is transpiled via Babel, imports are rewritten to browser-resolvable URLs, and the default export is rendered as a Preact component (when `runtime: \\\"preact\\\"`) or as a RuntimeNode tree.\"}],[\"/docs/runtime-plan-ir-84\",{\"id\":\"/docs/runtime-plan-ir-84\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#source-module\",\"content\":\"`runtime: \\\"renderify\\\"` expects the exported function to return `RuntimeNode | string` and can participate in the declarative execution/sandbox model.\"}],[\"/docs/runtime-plan-ir-85\",{\"id\":\"/docs/runtime-plan-ir-85\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#source-module\",\"content\":\"`runtime: \\\"preact\\\"` expects a Preact-compatible component and should be rendered with `renderTrustedPlanInBrowser` or the `trusted` security profile.\"}],[\"/docs/runtime-plan-ir-86\",{\"id\":\"/docs/runtime-plan-ir-86\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#source-module\",\"content\":\"`runtime: \\\"preact\\\"` does not run inside the browser worker/iframe/ShadowRealm sandbox adapters.\"}],[\"/docs/runtime-plan-ir-87\",{\"id\":\"/docs/runtime-plan-ir-87\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"The IR package includes pre-resolved module mappings for the React/Preact ecosystem:\"}],[\"/docs/runtime-plan-ir-88\",{\"id\":\"/docs/runtime-plan-ir-88\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"Specifier\"}],[\"/docs/runtime-plan-ir-89\",{\"id\":\"/docs/runtime-plan-ir-89\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"Resolved To\"}],[\"/docs/runtime-plan-ir-90\",{\"id\":\"/docs/runtime-plan-ir-90\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact`\"}],[\"/docs/runtime-plan-ir-91\",{\"id\":\"/docs/runtime-plan-ir-91\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact@10.28.3/dist/preact.module.js`\"}],[\"/docs/runtime-plan-ir-92\",{\"id\":\"/docs/runtime-plan-ir-92\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact/hooks`\"}],[\"/docs/runtime-plan-ir-93\",{\"id\":\"/docs/runtime-plan-ir-93\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact@10.28.3/hooks/dist/hooks.module.js`\"}],[\"/docs/runtime-plan-ir-94\",{\"id\":\"/docs/runtime-plan-ir-94\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact/compat`\"}],[\"/docs/runtime-plan-ir-95\",{\"id\":\"/docs/runtime-plan-ir-95\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact@10.28.3/compat/dist/compat.module.js`\"}],[\"/docs/runtime-plan-ir-96\",{\"id\":\"/docs/runtime-plan-ir-96\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`react`\"}],[\"/docs/runtime-plan-ir-97\",{\"id\":\"/docs/runtime-plan-ir-97\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact@10.28.3/compat/dist/compat.module.js`\"}],[\"/docs/runtime-plan-ir-98\",{\"id\":\"/docs/runtime-plan-ir-98\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`react-dom`\"}],[\"/docs/runtime-plan-ir-99\",{\"id\":\"/docs/runtime-plan-ir-99\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact@10.28.3/compat/dist/compat.module.js`\"}],[\"/docs/runtime-plan-ir-100\",{\"id\":\"/docs/runtime-plan-ir-100\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`react-dom/client`\"}],[\"/docs/runtime-plan-ir-101\",{\"id\":\"/docs/runtime-plan-ir-101\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact@10.28.3/compat/dist/compat.module.js`\"}],[\"/docs/runtime-plan-ir-102\",{\"id\":\"/docs/runtime-plan-ir-102\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`react/jsx-runtime`\"}],[\"/docs/runtime-plan-ir-103\",{\"id\":\"/docs/runtime-plan-ir-103\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`preact@10.28.3/jsx-runtime/dist/jsxRuntime.module.js`\"}],[\"/docs/runtime-plan-ir-104\",{\"id\":\"/docs/runtime-plan-ir-104\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`recharts`\"}],[\"/docs/runtime-plan-ir-105\",{\"id\":\"/docs/runtime-plan-ir-105\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"`recharts@3.3.0/es6/index.js`\"}],[\"/docs/runtime-plan-ir-106\",{\"id\":\"/docs/runtime-plan-ir-106\",\"page_id\":\"/docs/runtime-plan-ir\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/runtime-plan-ir#built-in-compatibility-aliases\",\"content\":\"These aliases mean LLMs can generate standard React code that runs directly via Preact.\"}],[\"/docs/sandboxed-frame\",{\"id\":\"/docs/sandboxed-frame\",\"page_id\":\"/docs/sandboxed-frame\",\"type\":\"page\",\"content\":\"Sandboxed frame\",\"breadcrumbs\":[\"Documentation\",\"Runtime\"],\"tags\":[],\"url\":\"/docs/sandboxed-frame\"}],[\"/docs/sandboxed-frame-0\",{\"id\":\"/docs/sandboxed-frame-0\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame\",\"content\":\"Run model-written JSX, TSX, and RuntimePlans in an opaque-origin iframe with @renderify/frame.\"}],[\"/docs/sandboxed-frame-1\",{\"id\":\"/docs/sandboxed-frame-1\",\"page_id\":\"/docs/sandboxed-frame\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/sandboxed-frame#sandboxed-frame\",\"content\":\"Sandboxed frame\"}],[\"/docs/sandboxed-frame-2\",{\"id\":\"/docs/sandboxed-frame-2\",\"page_id\":\"/docs/sandboxed-frame\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/sandboxed-frame#quick-start\",\"content\":\"Quick start\"}],[\"/docs/sandboxed-frame-3\",{\"id\":\"/docs/sandboxed-frame-3\",\"page_id\":\"/docs/sandboxed-frame\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"What the frame guarantees\"}],[\"/docs/sandboxed-frame-4\",{\"id\":\"/docs/sandboxed-frame-4\",\"page_id\":\"/docs/sandboxed-frame\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/sandboxed-frame#options\",\"content\":\"Options\"}],[\"/docs/sandboxed-frame-5\",{\"id\":\"/docs/sandboxed-frame-5\",\"page_id\":\"/docs/sandboxed-frame\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/sandboxed-frame#self-hosting-the-runner\",\"content\":\"Self-hosting the runner\"}],[\"/docs/sandboxed-frame-6\",{\"id\":\"/docs/sandboxed-frame-6\",\"page_id\":\"/docs/sandboxed-frame\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/sandboxed-frame#choosing-a-lane\",\"content\":\"Choosing a lane\"}],[\"/docs/sandboxed-frame-7\",{\"id\":\"/docs/sandboxed-frame-7\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#sandboxed-frame\",\"content\":\"`@renderify/frame` runs untrusted UI code, such as JSX a model just wrote, in an\\n`<iframe sandbox=\\\"allow-scripts\\\">` with an opaque origin. The code renders and\\nstays interactive, but it cannot read your page, cookies, or storage, and it\\ntalks to your page only through actions you allow.\"}],[\"/docs/sandboxed-frame-8\",{\"id\":\"/docs/sandboxed-frame-8\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#sandboxed-frame\",\"content\":\"Use it when declarative RuntimePlans are not enough: npm libraries, custom\\ncomponents, or anything you would otherwise have to run with the `trusted`\\nprofile. The website Playground uses the same frame.\"}],[\"/docs/sandboxed-frame-9\",{\"id\":\"/docs/sandboxed-frame-9\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#quick-start\",\"content\":\"`render` also accepts a RuntimePlan: `frame.render({ plan })`. Declarative\\nevents such as `onClick: \\\"save\\\"` become actions too.\"}],[\"/docs/sandboxed-frame-10\",{\"id\":\"/docs/sandboxed-frame-10\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"Property\"}],[\"/docs/sandboxed-frame-11\",{\"id\":\"/docs/sandboxed-frame-11\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"How\"}],[\"/docs/sandboxed-frame-12\",{\"id\":\"/docs/sandboxed-frame-12\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"No access to the host page\"}],[\"/docs/sandboxed-frame-13\",{\"id\":\"/docs/sandboxed-frame-13\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"`sandbox=\\\"allow-scripts\\\"` without `allow-same-origin` gives the content an opaque origin.\"}],[\"/docs/sandboxed-frame-14\",{\"id\":\"/docs/sandboxed-frame-14\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"Limited network\"}],[\"/docs/sandboxed-frame-15\",{\"id\":\"/docs/sandboxed-frame-15\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"The frame's CSP allows scripts and requests only to the runner's origin and the module CDNs (`ga.jspm.io`, `cdn.jspm.io`, `esm.sh` by default). Frames, workers, form submission, and `<base>` are blocked.\"}],[\"/docs/sandboxed-frame-16\",{\"id\":\"/docs/sandboxed-frame-16\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"Private channel\"}],[\"/docs/sandboxed-frame-17\",{\"id\":\"/docs/sandboxed-frame-17\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/sandboxed-frame#what-the-frame-guarantees\",\"content\":\"The host connects with a transferred `MessagePort`. The runner accepts a connection only from its parent window, and only once.\"}],[\"/docs/sandboxed-frame-18\",{\"id\":\"/docs/sandboxed-frame-18\",\"page_id\":\"/docs/sandboxed-frame\",\"tags\":[],\