curity-235\",{\"id\":\"/docs/security-235\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#defense-in-depth-layers\",\"content\":\"5\"}],[\"/docs/security-236\",{\"id\":\"/docs/security-236\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#defense-in-depth-layers\",\"content\":\"UI renderer\"}],[\"/docs/security-237\",{\"id\":\"/docs/security-237\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#defense-in-depth-layers\",\"content\":\"XSS sanitization, attribute filtering, URL validation\"}],[\"/docs/security-238\",{\"id\":\"/docs/security-238\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#defense-in-depth-layers\",\"content\":\"6\"}],[\"/docs/security-239\",{\"id\":\"/docs/security-239\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#defense-in-depth-layers\",\"content\":\"Sandbox\"}],[\"/docs/security-240\",{\"id\":\"/docs/security-240\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#defense-in-depth-layers\",\"content\":\"Optional Worker/iframe isolation for untrusted source\"}],[\"/docs/security-241\",{\"id\":\"/docs/security-241\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#mcp-apps-offline-boundary\",\"content\":\"`@renderify/mcp-app` is intentionally narrower than the general runtime. It\\naccepts only explicit `runtime-plan/v1` element/text trees and rejects source,\\ncomponent nodes, imports, module manifests, network hosts, storage, timers, and\\nnon-standard execution profiles on both server and view sides.\"}],[\"/docs/security-242\",{\"id\":\"/docs/security-242\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#mcp-apps-offline-boundary\",\"content\":\"The generated resource uses hashed inline scripts, no `unsafe-eval`, no script\\n`unsafe-inline`, no external MCP resource/connect/frame domains, and no browser\\npermissions. The official `PostMessageTransport` validates that messages come\\nfrom `window.parent`; app-to-server tool calls additionally require an exact\\nlocal allowlist and host capability.\"}],[\"/docs/security-243\",{\"id\":\"/docs/security-243\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#mcp-apps-offline-boundary\",\"content\":\"Apps registered with `sourceMode: true` also accept model-written source. The\\nview renders it only in a sandboxed `@renderify/frame` nested inside it, and\\nthe view's CSP adds the frame runner's hash, `blob:`, and the declared module\\nCDNs, never `unsafe-eval`. See\\nADR-0002.\"}],[\"/docs/security-244\",{\"id\":\"/docs/security-244\",\"page_id\":\"/docs/security\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/security#mcp-apps-offline-boundary\",\"content\":\"These controls do not authorize server tools and cannot force a host to create\\na strong outer iframe sandbox. See the\\narchitecture decision and\\nthreat model for the complete contract and residual risk.\"}],[\"/docs/threat-model\",{\"id\":\"/docs/threat-model\",\"page_id\":\"/docs/threat-model\",\"type\":\"page\",\"content\":\"Threat model\",\"breadcrumbs\":[\"Documentation\",\"Runtime\"],\"tags\":[],\"url\":\"/docs/threat-model\"}],[\"/docs/threat-model-0\",{\"id\":\"/docs/threat-model-0\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model\",\"content\":\"Trust boundaries, protected assets, attacker capabilities, mitigations, and residual risks.\"}],[\"/docs/threat-model-1\",{\"id\":\"/docs/threat-model-1\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#renderify-threat-model\",\"content\":\"Renderify threat model\"}],[\"/docs/threat-model-2\",{\"id\":\"/docs/threat-model-2\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#scope\",\"content\":\"Scope\"}],[\"/docs/threat-model-3\",{\"id\":\"/docs/threat-model-3\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#assets\",\"content\":\"Assets\"}],[\"/docs/threat-model-4\",{\"id\":\"/docs/threat-model-4\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#trust-boundaries\",\"content\":\"Trust boundaries\"}],[\"/docs/threat-model-5\",{\"id\":\"/docs/threat-model-5\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#attacker-capabilities\",\"content\":\"Attacker capabilities\"}],[\"/docs/threat-model-6\",{\"id\":\"/docs/threat-model-6\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Defense layers and guarantee level\"}],[\"/docs/threat-model-7\",{\"id\":\"/docs/threat-model-7\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"MCP App-specific rules\"}],[\"/docs/threat-model-8\",{\"id\":\"/docs/threat-model-8\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#mcp-source-mode-rules\",\"content\":\"MCP source mode rules\"}],[\"/docs/threat-model-9\",{\"id\":\"/docs/threat-model-9\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"Sandboxed frame rules\"}],[\"/docs/threat-model-10\",{\"id\":\"/docs/threat-model-10\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#residual-risks\",\"content\":\"Residual risks\"}],[\"/docs/threat-model-11\",{\"id\":\"/docs/threat-model-11\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#out-of-scope\",\"content\":\"Out of scope\"}],[\"/docs/threat-model-12\",{\"id\":\"/docs/threat-model-12\",\"page_id\":\"/docs/threat-model\",\"type\":\"heading\",\"tags\":[],\"url\":\"/docs/threat-model#reporting\",\"content\":\"Reporting\"}],[\"/docs/threat-model-13\",{\"id\":\"/docs/threat-model-13\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#scope\",\"content\":\"Renderify consumes model- or application-produced UI descriptions. A\\n`RuntimePlan`, its state, metadata, source, imports, and event payloads MUST be\\ntreated as attacker-controlled unless the caller has established a stronger\\ntrust relationship.\"}],[\"/docs/threat-model-14\",{\"id\":\"/docs/threat-model-14\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#scope\",\"content\":\"This document distinguishes the general Renderify runtime from the narrower\\n`@renderify/mcp-app` contract. The MCP package does not expose the general\\nruntime's trusted source path; apps that opt into source mode run source only\\nin a sandboxed frame nested in the view.\"}],[\"/docs/threat-model-15\",{\"id\":\"/docs/threat-model-15\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Asset\"}],[\"/docs/threat-model-16\",{\"id\":\"/docs/threat-model-16\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Security concern\"}],[\"/docs/threat-model-17\",{\"id\":\"/docs/threat-model-17\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Host DOM, cookies, and credentials\"}],[\"/docs/threat-model-18\",{\"id\":\"/docs/threat-model-18\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Script execution or sandbox escape could act as the user.\"}],[\"/docs/threat-model-19\",{\"id\":\"/docs/threat-model-19\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Data placed in plan/context/state\"}],[\"/docs/threat-model-20\",{\"id\":\"/docs/threat-model-20\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"UI or model-context output could disclose it.\"}],[\"/docs/threat-model-21\",{\"id\":\"/docs/threat-model-21\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"MCP server tools\"}],[\"/docs/threat-model-22\",{\"id\":\"/docs/threat-model-22\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"A confused deputy could perform unauthorized side effects.\"}],[\"/docs/threat-model-23\",{\"id\":\"/docs/threat-model-23\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Network identity\"}],[\"/docs/threat-model-24\",{\"id\":\"/docs/threat-model-24\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Unexpected fetches could exfiltrate data or load code.\"}],[\"/docs/threat-model-25\",{\"id\":\"/docs/threat-model-25\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Module supply chain\"}],[\"/docs/threat-model-26\",{\"id\":\"/docs/threat-model-26\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Unpinned or unverified modules can replace executable code.\"}],[\"/docs/threat-model-27\",{\"id\":\"/docs/threat-model-27\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Availability\"}],[\"/docs/threat-model-28\",{\"id\":\"/docs/threat-model-28\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#assets\",\"content\":\"Large plans, repeated events, and runtime work can consume resources.\"}],[\"/docs/threat-model-29\",{\"id\":\"/docs/threat-model-29\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#trust-boundaries\",\"content\":\"What this shows: direct trusted-source rendering and the offline MCP adapter\\nhave different boundaries and MUST NOT be described as equivalent.\"}],[\"/docs/threat-model-30\",{\"id\":\"/docs/threat-model-30\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#trust-boundaries\",\"content\":\"Trusted computing base for the MCP path: the host, browser sandbox/CSP\\nimplementation, official MCP Apps SDK, the static shell, Renderify validators,\\nsecurity checker, runtime manager, and UI renderer. A defect in those units can\\ninvalidate the boundary.\"}],[\"/docs/threat-model-31\",{\"id\":\"/docs/threat-model-31\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#attacker-capabilities\",\"content\":\"The attacker may control the complete tool result plan, including text, tags,\\nattributes, local state, transitions, event types and payloads, and metadata.\\nThey may send an over-limit or malformed payload, attempt active URLs or blocked\\ntags, request a sensitive tool, spoof a postMessage from another frame, mislead\\nthe user, or repeat actions to consume CPU/memory.\"}],[\"/docs/threat-model-32\",{\"id\":\"/docs/threat-model-32\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#attacker-capabilities\",\"content\":\"For general trusted/relaxed runtime APIs, the attacker may also control source\\nand imports if the caller incorrectly treats model output as reviewed code.\"}],[\"/docs/threat-model-33\",{\"id\":\"/docs/threat-model-33\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Layer\"}],[\"/docs/threat-model-34\",{\"id\":\"/docs/threat-model-34\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Mechanism\"}],[\"/docs/threat-model-35\",{\"id\":\"/docs/threat-model-35\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Scope and strength\"}],[\"/docs/threat-model-36\",{\"id\":\"/docs/threat-model-36\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"IR guards\"}],[\"/docs/threat-model-37\",{\"id\":\"/docs/threat-model-37\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Plain-JSON shape, safe state paths, RuntimeNode traversal\"}],[\"/docs/threat-model-38\",{\"id\":\"/docs/threat-model-38\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Exact for the checked structure.\"}],[\"/docs/threat-model-39\",{\"id\":\"/docs/threat-model-39\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Security policy\"}],[\"/docs/threat-model-40\",{\"id\":\"/docs/threat-model-40\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Tags, URLs, capabilities, budgets, module policy\"}],[\"/docs/threat-model-41\",{\"id\":\"/docs/threat-model-41\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Exact for implemented checks; configuration can widen it.\"}],[\"/docs/threat-model-42\",{\"id\":\"/docs/threat-model-42\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Source pattern scan\"}],[\"/docs/threat-model-43\",{\"id\":\"/docs/threat-model-43\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Banned token/regex patterns\"}],[\"/docs/threat-model-44\",{\"id\":\"/docs/threat-model-44\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Best-effort only; not a JavaScript isolation boundary.\"}],[\"/docs/threat-model-45\",{\"id\":\"/docs/threat-model-45\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Declarative renderer\"}],[\"/docs/threat-model-46\",{\"id\":\"/docs/threat-model-46\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Tag/attribute/style/URL sanitization and delegated events\"}],[\"/docs/threat-model-47\",{\"id\":\"/docs/threat-model-47\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Applies to RuntimeNode rendering, not trusted Preact source output.\"}],[\"/docs/threat-model-48\",{\"id\":\"/docs/threat-model-48\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Runtime isolation profiles\"}],[\"/docs/threat-model-49\",{\"id\":\"/docs/threat-model-49\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Worker/iframe modes and fail-closed behavior\"}],[\"/docs/threat-model-50\",{\"id\":\"/docs/threat-model-50\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Depends on selected profile, browser, and host CSP.\"}],[\"/docs/threat-model-51\",{\"id\":\"/docs/threat-model-51\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"MCP validator\"}],[\"/docs/threat-model-52\",{\"id\":\"/docs/threat-model-52\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Rejects source/modules/network/storage/timers and caps JSON size\"}],[\"/docs/threat-model-53\",{\"id\":\"/docs/threat-model-53\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Exact for the accepted MCP plan contract.\"}],[\"/docs/threat-model-54\",{\"id\":\"/docs/threat-model-54\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"MCP shell CSP\"}],[\"/docs/threat-model-55\",{\"id\":\"/docs/threat-model-55\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Script hashes, no connection/worker/frame/object sources\"}],[\"/docs/threat-model-56\",{\"id\":\"/docs/threat-model-56\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Browser-enforced inside the resource when the host preserves it.\"}],[\"/docs/threat-model-57\",{\"id\":\"/docs/threat-model-57\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"MCP source frame\"}],[\"/docs/threat-model-58\",{\"id\":\"/docs/threat-model-58\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Opt-in nested `@renderify/frame`, hash-pinned inline runner, view-side action allowlist\"}],[\"/docs/threat-model-59\",{\"id\":\"/docs/threat-model-59\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Only for apps registered with `sourceMode`; relies on the browser sandbox and on the host preserving the declared CSP.\"}],[\"/docs/threat-model-60\",{\"id\":\"/docs/threat-model-60\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Host sandbox\"}],[\"/docs/threat-model-61\",{\"id\":\"/docs/threat-model-61\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Unique-origin iframe and permissions policy\"}],[\"/docs/threat-model-62\",{\"id\":\"/docs/threat-model-62\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Host-owned; the package declares needs but cannot force host flags.\"}],[\"/docs/threat-model-63\",{\"id\":\"/docs/threat-model-63\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Official transport\"}],[\"/docs/threat-model-64\",{\"id\":\"/docs/threat-model-64\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Valid JSON-RPC and `event.source === window.parent`\"}],[\"/docs/threat-model-65\",{\"id\":\"/docs/threat-model-65\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Rejects sibling-frame messages; target origin is `*` because sandbox origins may be opaque.\"}],[\"/docs/threat-model-66\",{\"id\":\"/docs/threat-model-66\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Tool allowlist\"}],[\"/docs/threat-model-67\",{\"id\":\"/docs/threat-model-67\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Exact view-side name match plus host capability\"}],[\"/docs/threat-model-68\",{\"id\":\"/docs/threat-model-68\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#defense-layers-and-guarantee-level\",\"content\":\"Routing gate only; server authentication/authorization remains mandatory.\"}],[\"/docs/threat-model-69\",{\"id\":\"/docs/threat-model-69\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"Unless the app opts into source mode, the shell and `_meta.ui.csp` declare\\nno external origins or browser permissions.\"}],[\"/docs/threat-model-70\",{\"id\":\"/docs/threat-model-70\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"A 512 KiB default limit bounds accepted plan JSON; the host still receives\\nthe original MCP message before view validation.\"}],[\"/docs/threat-model-71\",{\"id\":\"/docs/threat-model-71\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"Strict policy limits depth, node count, transitions, and actions in addition\\nto the MCP-specific exclusions.\"}],[\"/docs/threat-model-72\",{\"id\":\"/docs/threat-model-72\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"SVG animation and timed mutation elements are rejected so browser-managed\\nupdates cannot change a URL attribute after validation.\"}],[\"/docs/threat-model-73\",{\"id\":\"/docs/threat-model-73\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"Fragment-only hrefs are element-sensitive because a `srcdoc` app inherits\\nthe embedding page's base URL. Navigation and resource-loading elements may\\nnot use those hrefs; only explicit local SVG references and functional IRIs\\nare accepted.\"}],[\"/docs/threat-model-74\",{\"id\":\"/docs/threat-model-74\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"CSS `image-set()` and `-webkit-image-set()` are rejected in URL-bearing\\nattributes and inline styles because quoted candidates can load without a\\n`url()` token; CSS escapes and comments are normalized before inspection.\"}],[\"/docs/threat-model-75\",{\"id\":\"/docs/threat-model-75\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"URL-bearing MCP attributes cannot contain runtime templates. Rejecting them\\nbefore execution prevents state, context, or event interpolation from\\nintroducing a relative or active URL after the boundary check.\"}],[\"/docs/threat-model-76\",{\"id\":\"/docs/threat-model-76\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"Declarative `onClick` data becomes delegated runtime events. It never becomes\\nan HTML `on*` attribute or evaluated JavaScript; case-variant event attribute\\nnames are rejected instead of falling through to HTML serialization.\"}],[\"/docs/threat-model-77\",{\"id\":\"/docs/threat-model-77\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"Runtime transition dispatch uses own-property lookup, so event names such as\\n`constructor` and `__proto__` cannot resolve inherited prototype members as\\naction lists.\"}],[\"/docs/threat-model-78\",{\"id\":\"/docs/threat-model-78\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"Model-context updates contain attacker-influenced state/event data. Hosts and\\nmodels MUST treat it as untrusted context, not instructions with authority.\"}],[\"/docs/threat-model-79\",{\"id\":\"/docs/threat-model-79\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"Tool arguments originate in the plan and, through bound inputs, form fields,\\nand `{\\\"$from\\\"}` payload references, in what the user typed. Servers MUST\\nvalidate them and require confirmation for destructive or sensitive effects.\"}],[\"/docs/threat-model-80\",{\"id\":\"/docs/threat-model-80\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"Forms render as inert containers whose submit is emulated, so plan content\\ncannot navigate the frame or post fields to another origin. Password and\\nfile inputs are never read into state, payloads, or model context, which\\nlimits (but does not prevent) credential phishing through generated forms.\"}],[\"/docs/threat-model-81\",{\"id\":\"/docs/threat-model-81\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"`each` expansion is capped at 10,000 rendered nodes per render, and\\ntemplated action paths must resolve to single safe segments before any\\nstate write.\"}],[\"/docs/threat-model-82\",{\"id\":\"/docs/threat-model-82\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-app-specific-rules\",\"content\":\"The registration helper forwards the official request context so handlers can\\ninspect transport-provided authentication, cancellation, session, and request\\nmetadata instead of relying only on attacker-controlled tool arguments.\"}],[\"/docs/threat-model-83\",{\"id\":\"/docs/threat-model-83\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-source-mode-rules\",\"content\":\"These apply only to apps registered with `sourceMode: true`\\n(ADR-0002).\"}],[\"/docs/threat-model-84\",{\"id\":\"/docs/threat-model-84\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-source-mode-rules\",\"content\":\"Source runs only in a `sandbox=\\\"allow-scripts\\\"` frame nested in the view,\\nnever in the view's window. The host bridge accepts messages only from the\\nview's window and the view's bridge only from the host, so JSON-RPC posted\\nfrom the nested frame reaches neither.\"}],[\"/docs/threat-model-85\",{\"id\":\"/docs/threat-model-85\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-source-mode-rules\",\"content\":\"The nested frame reaches server tools only through\\n`window.renderify.action(\\\"tool:<name>\\\", args)`, and only when `<name>` is in\\n`allowedTools`. Those arguments come from model-written code: servers MUST\\nvalidate and authorize them like any other tool input.\"}],[\"/docs/threat-model-86\",{\"id\":\"/docs/threat-model-86\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-source-mode-rules\",\"content\":\"The runner is inlined as a non-executing data block and allowed by its\\nSHA-256 hash. The view's CSP adds that hash, `blob:`, and the declared\\nmodule CDNs; it adds no `unsafe-eval` or script `unsafe-inline`, and frames\\nand workers stay blocked.\"}],[\"/docs/threat-model-87\",{\"id\":\"/docs/threat-model-87\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-source-mode-rules\",\"content\":\"The declared module CDNs are an exfiltration path: code in the frame can put\\nanything it was given into request URLs to them. Source payloads and tool\\nresults rendered in source mode MUST NOT carry secrets.\"}],[\"/docs/threat-model-88\",{\"id\":\"/docs/threat-model-88\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#mcp-source-mode-rules\",\"content\":\"Source payloads are limited to 256 KiB by default, and views without source\\nmode reject them before anything renders.\"}],[\"/docs/threat-model-89\",{\"id\":\"/docs/threat-model-89\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"`@renderify/frame` is the boundary for running model-written source in a\\nbrowser (ADR-0002).\"}],[\"/docs/threat-model-90\",{\"id\":\"/docs/threat-model-90\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"The iframe uses `sandbox=\\\"allow-scripts\\\"` only. Content has an opaque origin\\nand cannot read host DOM, cookies, or storage, submit forms, open popups, or\\nnavigate the top window.\"}],[\"/docs/threat-model-91\",{\"id\":\"/docs/threat-model-91\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"The `srcdoc` CSP allows scripts only from the runner origin, the configured\\nmodule CDNs, and `blob:`, and network requests only to those CDNs. Frames,\\nworkers, `<base>`, and form submission are blocked.\"}],[\"/docs/threat-model-92\",{\"id\":\"/docs/threat-model-92\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"The runner accepts one connection, and only from `window.parent`. The host\\nreceives messages only on that port and validates and size-limits each one.\"}],[\"/docs/threat-model-93\",{\"id\":\"/docs/threat-model-93\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"Content reaches the host only through actions whose types the host\\nallowlists; nothing in the host is callable from the frame.\"}],[\"/docs/threat-model-94\",{\"id\":\"/docs/threat-model-94\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"Synchronous loops get transpile-time time checks, and a host watchdog\\nreplaces the iframe when a render does not finish.\"}],[\"/docs/threat-model-95\",{\"id\":\"/docs/threat-model-95\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"The default runner is version-pinned and loaded with Subresource Integrity.\"}],[\"/docs/threat-model-96\",{\"id\":\"/docs/threat-model-96\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#sandboxed-frame-rules\",\"content\":\"Frame residual risks: content can mislead users inside its rectangle; data\\ngiven to the frame can leak through module CDN request URLs; and a blocking\\ncall that is not a loop can stall the host in browsers that run opaque-origin\\nframes on the embedder's thread. MCP Apps run source only when the app opts\\ninto source mode, inside a frame nested in the view; see ADR-0002.\"}],[\"/docs/threat-model-97\",{\"id\":\"/docs/threat-model-97\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#residual-risks\",\"content\":\"Declarative text and layout can still phish or mislead a user, and a\\ngenerated form can ask for sensitive data in a plain text field.\"}],[\"/docs/threat-model-98\",{\"id\":\"/docs/threat-model-98\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#residual-risks\",\"content\":\"Repeated local transitions can grow state or consume browser resources until\\nthe host tears down the iframe.\"}],[\"/docs/threat-model-99\",{\"id\":\"/docs/threat-model-99\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#residual-risks\",\"content\":\"A weak or non-conforming host sandbox reduces containment; the inner CSP does\\nnot replace the outer iframe boundary.\"}],[\"/docs/threat-model-100\",{\"id\":\"/docs/threat-model-100\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#residual-risks\",\"content\":\"A compromised official dependency or Renderify TCB component can invalidate\\nassumptions.\"}],[\"/docs/threat-model-101\",{\"id\":\"/docs/threat-model-101\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#residual-risks\",\"content\":\"The current evidence is automated testing, not a third-party security audit.\"}],[\"/docs/threat-model-102\",{\"id\":\"/docs/threat-model-102\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#residual-risks\",\"content\":\"General trusted/relaxed source modes remain trusted-code features and MUST NOT\\nbe inferred safe from the MCP declarative result.\"}],[\"/docs/threat-model-103\",{\"id\":\"/docs/threat-model-103\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#residual-risks\",\"content\":\"MCP source mode has been tested with the official bridge and the reference\\nhost's CSP, not yet on production hosts, whose CSP and frame handling may\\ndiffer.\"}],[\"/docs/threat-model-104\",{\"id\":\"/docs/threat-model-104\",\"page_id\":\"/docs/threat-model\",\"tags\":[],\"type\":\"text\",\"url\":\"/docs/threat-model#out-o